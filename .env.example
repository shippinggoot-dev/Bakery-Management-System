# ─── Supabase ────────────────────────────────────────────────────────────────
# Connection string for Drizzle ORM (use the "Transaction" pooler URL from Supabase dashboard)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection URL for Drizzle Kit migrations (use the "Session" pooler or direct connection)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ─── Supabase Public Keys (for client-side usage) ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"

# ─── Shopify OAuth (required for the "Connect with Shopify" flow) ────────────
# Create a Shopify app at https://partners.shopify.com → Apps → Create app
# (or use the Dev Dashboard if you're on the newer Shopify experience).
#
# Then in the app's configuration / version:
#   - Set the App URL to:           https://[YOUR-DEPLOY-URL]
#   - Set the Allowed redirection:  https://[YOUR-DEPLOY-URL]/api/shopify/oauth/callback
#   - Set the GDPR webhook URLs to: https://[YOUR-DEPLOY-URL]/api/shopify/webhooks/customers-data-request
#                                   https://[YOUR-DEPLOY-URL]/api/shopify/webhooks/customers-redact
#                                   https://[YOUR-DEPLOY-URL]/api/shopify/webhooks/shop-redact
#   - Configure Admin API scopes:   read_products,write_products,read_orders,read_customers,read_locations,write_inventory
#
# Then copy these two values from the app's Login information / API credentials page:
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""

# Base URL the OAuth callback redirects back to. Must match the App URL in Shopify.
# Use the deployed URL in production, or http://localhost:3000 for local dev with
# a tunnel (ngrok, cloudflared) since Shopify requires HTTPS.
SHOPIFY_APP_URL="https://bakery-management-system-web.vercel.app"

# Optional: separate secret used to sign the OAuth state cookie. Defaults to
# SHOPIFY_API_SECRET if not set — fine for most deployments.
# SHOPIFY_OAUTH_COOKIE_SECRET=""

# ─── Token encryption at rest ──────────────────────────────────────────────────
# Used to encrypt third-party API tokens (Shopify access token + webhook secret,
# Resend API key) before they hit the database.
# Required — without it, the app will throw on any token read/write.
#
# Generate ONCE with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Then set the SAME value in:
#   - Vercel → Production environment
#   - Vercel → Preview environment (same value, otherwise preview cannot
#     read production-encrypted tokens)
#   - Your local .env
#
# Rotating this key is a destructive operation: it invalidates every existing
# encrypted token. Don't rotate without a planned re-encryption migration.
TOKEN_ENCRYPTION_KEY=""

# ─── Rate limiting (Upstash Redis) ─────────────────────────────────────────────
# Required in production. Without these, rate limiting fails open (requests
# go through) and a warning is logged on first call.
#
# Create a free Redis database at https://console.upstash.com (no credit card
# needed for the free tier: 10K commands/day, 256MB), then copy:
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Optional: Supabase Storage (required for social post photo uploads) ─────
# Create a public bucket named "instagram-media" in your Supabase dashboard:
# Storage → New bucket → Name: instagram-media → Public: ON
# (The bucket name is "instagram-media" for historical reasons — it now holds
#  photos for any social network. Renaming a bucket with existing objects is
#  invasive in Supabase, so the legacy name stays.)

# ─── Optional: AI assistant (social planner caption / weekly plan / brand voice) ─
# Without this key, AI buttons in the social planner show "AI features not
# configured" and remain inert. Manual posting, scheduling, and drafts all
# work without it.
#
# Get a key at console.anthropic.com (free signup; you pay per token used).
# Cost estimate: ~€0.20/month per active free-tier user. See ai-cost.ts for
# the pricing breakdown.
ANTHROPIC_API_KEY=""

# Email address shown in the "Upgrade" placeholder for AI quotas. Until the
# Stripe checkout flow is built, users who hit their monthly AI quota are
# directed to mail this address.
SUPPORT_EMAIL=""

# ─── In-app feedback widget ──────────────────────────────────────────────────
# When a bakery owner submits feedback via the floating "Feedback" button,
# a minimal notification is posted to this Discord webhook (category + sender
# + link to /feedback). The full message and screenshot live in the database;
# Discord only receives the doorbell ping. Leave empty to disable Discord
# notifications — feedback is still saved to the database either way.
#
# Create at: your Discord server → channel settings → Integrations →
# Webhooks → New Webhook → Copy URL.
DISCORD_FEEDBACK_WEBHOOK_URL=""

# Comma-separated list of emails that can access the /feedback admin page
# (and read screenshots). Keep in sync with the matching RLS policy in
# packages/db/migrations/manual/2026-06-12_feedback.sql — to add an admin
# you must update BOTH this env var AND the policy's email array.
SUPER_ADMIN_EMAILS=""

# Public base URL of the app, used in Discord notifications to construct the
# clickable link to /feedback. Falls back to SHOPIFY_APP_URL if unset.
NEXT_PUBLIC_APP_URL=""
