# ─── Supabase ────────────────────────────────────────────────────────────────
# Connection string for Drizzle ORM (use the "Transaction" pooler URL from Supabase dashboard)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection URL for Drizzle Kit migrations (use the "Session" pooler or direct connection)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ─── Supabase Public Keys (for client-side usage) ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"

# ─── Optional: Shopify (stored per-user in the database, no env vars needed) ──
# Shopify credentials are entered by each user through Settings → Shopify.
# No server-level environment variables are required for Shopify.

# ─── Optional: Instagram / Meta (required for Instagram posting feature) ──────
# Create a Meta App at developers.facebook.com, add Instagram Graph API,
# then copy the App ID and App Secret from App Settings → Basic.
# Also add /api/instagram/callback as an OAuth Redirect URI in Facebook Login settings.
NEXT_PUBLIC_META_APP_ID=""
META_APP_SECRET=""

# ─── Optional: Supabase Storage (required for Instagram image uploads) ────────
# Create a public bucket named "instagram-media" in your Supabase dashboard:
# Storage → New bucket → Name: instagram-media → Public: ON
